{% set hero_poster = 'images/dst-hero-poster.jpg' | asset %}
<section data-testid="dst-home-hero" class="s-block s-block--hero-slider s-block--full-bg wide-placeholder dst-hero">
    <div class="swiper-slide w-full min-h-[560px] lg:min-h-[700px] bg-dark relative">
        <div style="background-image: url('{{ hero_poster }}');" class="dst-hero-media absolute inset-0 overflow-hidden overlay-bg">
            <video class="dst-hero-video absolute inset-0 w-full h-full object-cover"
                   autoplay muted loop playsinline preload="metadata"
                   poster="{{ hero_poster }}" aria-hidden="true">
                <source src="{{ 'videos/dst-hero.mp4' | asset }}" type="video/mp4">
            </video>
        </div>
        <div class="flex-center container home-slider__content relative h-full">
            <div class="w-full max-w-3xl text-center text-white dst-hero-copy">
                <p class="dst-hero-eyebrow">{{ trans('dst.hero_eyebrow') }}</p>
                <h1 class="dst-hero-title font-bold leading-tight">{{ trans('dst.hero_title') }}</h1>
                <p class="dst-hero-description">{{ trans('dst.hero_description') }}</p>
                <a href="{{ link('categories') }}" class="dst-hero-cta">{{ trans('dst.hero_cta') }}</a>
                <p class="dst-hero-trust">{{ trans('dst.hero_trust') }}</p>
                <div class="dst-hero-stats" aria-label="{{ trans('dst.hero_facts') }}">
                    <div class="dst-hero-stat">
                        <strong>430m</strong>
                        <span>{{ trans('dst.stat_depth') }}</span>
                    </div>
                    <div class="dst-hero-stat">
                        <strong>21</strong>
                        <span>{{ trans('dst.stat_minerals') }}</span>
                    </div>
                    <div class="dst-hero-stat">
                        <strong>30+</strong>
                        <span>{{ trans('dst.stat_years') }}</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
