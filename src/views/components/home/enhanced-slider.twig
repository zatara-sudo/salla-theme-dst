{#
| Variable                       | Type     | Description                                                                  |
|--------------------------------|----------|------------------------------------------------------------------------------|
| component                      | object   | Contains merchant settings for fields from twilight.json `component` section |
| component.slides[].image       | string   | Image url                                                                    |
| component.slides[].title       | ?string  |                                                                              |
| component.slides[].description | ?string  |                                                                              |
| component.slides               | object[] | list of slides                                                               |
| position                       | int      | Sorting number start from zero                                               |
#}
<section data-testid="store-home-slider" class="s-block s-block--hero-slider s-block--full-bg wide-placeholder dst-hero">
    <salla-slider
      id="main-slider-{{ position }}"
      static-when-single
      slider-config='{"lazy":"false"}'
      show-controls="false"
      type="fullwidth">
        <div slot="items">
            {% for slide in component.slides %}
                {% if loop.first %}
                    {% set hero_poster = 'images/dst-hero-poster.jpg' | asset %}
                    <div class="swiper-slide w-full min-h-[560px] lg:min-h-[700px] bg-dark relative">
                        <div style="background-image: url('{{ hero_poster }}');" class="dst-hero-media absolute inset-0 overflow-hidden overlay-bg">
                            <video class="dst-hero-video absolute inset-0 w-full h-full object-cover"
                                   autoplay muted loop playsinline preload="metadata"
                                   poster="{{ hero_poster }}" aria-hidden="true">
                                <source src="{{ 'videos/dst-hero.mp4' | asset }}" type="video/mp4">
                            </video>
                        </div>
                        <div class="flex-center container home-slider__content relative h-full">
                            <div class="w-full max-w-3xl text-center text-white dst-hero-copy">
                                <p data-swiper-parallax="-600" class="dst-hero-eyebrow">{{ trans('dst.hero_eyebrow') }}</p>
                                <h2 data-swiper-parallax="-500" class="dst-hero-title font-bold leading-tight">{{ trans('dst.hero_title') }}</h2>
                                <p data-swiper-parallax="-300" class="dst-hero-description">{{ trans('dst.hero_description') }}</p>
                                <a data-swiper-parallax="-200" href="{{ link('categories') }}" class="dst-hero-cta">{{ trans('dst.hero_cta') }}</a>
                                <p class="dst-hero-trust">{{ trans('dst.hero_trust') }}</p>
                                <div class="dst-hero-stats" aria-label="{{ trans('dst.hero_facts') }}">
                                    <div class="dst-hero-stat">
                                        <strong>430m</strong>
                                        <span>{{ trans('dst.stat_depth') }}</span>
                                    </div>
                                    <div class="dst-hero-stat">
                                        <strong>21</strong>
                                        <span>{{ trans('dst.stat_minerals') }}</span>
                                    </div>
                                    <div class="dst-hero-stat">
                                        <strong>30+</strong>
                                        <span>{{ trans('dst.stat_years') }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </salla-slider>
</section>
